# Local dev-tool settings and runtime lock files (machine-specific, not project content)
.devtool/settings.local.json
.devtool/scheduled_tasks.lock

# LibreOffice lock files
.~lock.*#

# Python
__pycache__/
*.pyc
.pytest_cache/

# Virtual environments
.venv/
venv/

# Generated data — regenerate via:
#   CycleGAN/Code/download_hirise.py, download_rover.py, preprocess.py
# Exceptions: training_log.csv, Data/eval/fid_results.json, and dtm_coverage JSON
# are tiny provenance records (KBs, not bulk data) and ARE tracked.
CycleGAN/Data/*
!CycleGAN/Data/eval/
CycleGAN/Data/eval/*
!CycleGAN/Data/eval/fid_results.json
!CycleGAN/Data/HiRISE_index/
CycleGAN/Data/HiRISE_index/*
!CycleGAN/Data/HiRISE_index/dtm_coverage_*.json

# Early-stage nadir super-resolution work, not published to this repo.
DiffusionSR/

# Training artifacts (move machine-to-machine via rsync, not git)
CycleGAN/checkpoints/
CycleGAN/logs/

# ControlNet (Phase 1 corpus pipeline + Phase 2 fine-tuning) -- same
# convention as CycleGAN/Data above. Corpus regenerate via:
#   ControlNet/Code/assemble_paired_corpus.py
# Exceptions: manifest.csv, eval result JSONs, and the feasibility report
# are tiny provenance records (KBs, not bulk data) and ARE tracked.
ControlNet/Data/*
!ControlNet/Data/processed/
ControlNet/Data/processed/*
!ControlNet/Data/processed/paired_controlnet_corpus/
ControlNet/Data/processed/paired_controlnet_corpus/*
!ControlNet/Data/processed/paired_controlnet_corpus/manifest.csv
!ControlNet/Data/eval/
ControlNet/Data/eval/*
!ControlNet/Data/eval/mars_model_eval.json
!ControlNet/Data/eval/fid_results_controlnet.json
!ControlNet/Data/eval/dtm_estimator_eval.json
!ControlNet/Data/HiRISE_index/
ControlNet/Data/HiRISE_index/*
!ControlNet/Data/HiRISE_index/controlnet_phase1_feasibility_report.json
!ControlNet/Data/HiRISE_index/jezero_archive_discovery_report.json

# DTM estimator qualitative output (small PNGs, same "visual training
# record" precedent as CycleGAN/samples/ below) -- ARE tracked.
!ControlNet/Data/dtm_estimator_visualizations/
!ControlNet/Data/dtm_estimator_spotcheck_output/
# End-to-end chain output (HiRISE -> DTM estimator -> render -> Track 3
# ControlNet) -- same precedent. gale_crop.npz (the fetch cache) is
# deliberately excluded, regenerate via prepare_e2e_crop.py. One dir per
# --pitch-deg test run (e.g. _pitch5 for the -5deg shallow-pitch test).
!ControlNet/Data/e2e_pipeline_output/
ControlNet/Data/e2e_pipeline_output/*
!ControlNet/Data/e2e_pipeline_output/*.png
!ControlNet/Data/e2e_pipeline_output/*.jpg
!ControlNet/Data/e2e_pipeline_output_pitch5/
ControlNet/Data/e2e_pipeline_output_pitch5/*
!ControlNet/Data/e2e_pipeline_output_pitch5/*.png
!ControlNet/Data/e2e_pipeline_output_pitch5/*.jpg
# _newcrop: same -15deg pitch as the original run, but at the
# find_e2e_crop_candidate.py-selected high-ground_entropy crop location
# instead of the raster-center crop both prior runs used.
!ControlNet/Data/e2e_pipeline_output_newcrop/
ControlNet/Data/e2e_pipeline_output_newcrop/*
!ControlNet/Data/e2e_pipeline_output_newcrop/*.png
!ControlNet/Data/e2e_pipeline_output_newcrop/*.jpg

# Training artifacts (move machine-to-machine via rsync, not git) --
# the ControlNet checkpoint is ~1.4GB, well past what git should hold.
ControlNet/checkpoints/
ControlNet/logs/

# LaTeX build byproducts (regenerate from .tex/.bib via latexmk/bibtex)
Literature review/*.aux
Literature review/*.bbl
Literature review/*.blg
Literature review/*.log
Methodology/*.aux
Methodology/*.bbl
Methodology/*.blg
Methodology/*.log
# Dissertation source and compiled PDF are not published to this repo.
Dissertation/
/images/

# Ad-hoc image review dumps (scratch output for visually spot-checking a
# model's generated samples, not a tracked project artifact).
ckpt100_sample_review/
